# Copy this file to .env for local development. On Vercel, set the same names under
# Project -> Settings -> Environment Variables (never commit real values).

# Required. Create at https://openrouter.ai/keys and give it a credit limit, because the chat
# page is public and every message is paid for from this key.
OPENROUTER_API_KEY=

# Required for /admin. At least 12 characters. Changing it signs everyone out.
ADMIN_PASSWORD=

# Required in production: where settings and transcripts are stored (https://turso.tech).
# Leave both empty locally and `npm run dev` uses a local.db file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Set to info or debug to see more in the Vercel function logs.
# LOG_LEVEL=info
